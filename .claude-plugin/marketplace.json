{
    "name": "vue-ts-lsp",
    "owner": {
        "name": "Tyler Satre",
        "email": "github@satre.co"
    },
    "plugins": [
        {
            "name": "vue-ts-lsp",
            "source": "./",
            "description": "Vue + TypeScript LSP for Claude Code",
            "lspServers": {
                "vue-ts-lsp": {
                    "command": "vue-ts-lsp",
                    "extensionToLanguage": {
                        ".vue": "vue",
                        ".ts": "typescript",
                        ".tsx": "typescriptreact",
                        ".js": "javascript",
                        ".jsx": "javascriptreact"
                    },
                    "startupTimeout": 30000
                }
            }
        }
    ]
}
